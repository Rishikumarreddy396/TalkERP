# TalkERP – Environment Configuration
# Copy this file to .env and fill in your secrets.
# ⚠️ NEVER commit the .env file — only this .env.example is safe to push.

# ── PostgreSQL ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://talkerp:password@localhost:5433/talkerp_db

# ── Groq API ──────────────────────────────────────────────────────────
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Application ───────────────────────────────────────────────────────
DEBUG=true
